# Shared identity Supabase project (server-only configuration).
AUTH_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
AUTH_SUPABASE_ANON_KEY=your_publishable_or_anon_key
AUTH_SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Exact frontend origins, comma-separated; never use a wildcard in production.
API_ALLOWED_ORIGINS=https://auth-binzeo.vercel.app,https://admin-binzeo.vercel.app,https://jabiyen-website.vercel.app
API_ENVIRONMENT=development
API_LOG_LEVEL=info

# Frontend origins used for redirects, email links and WebAuthn RP verification.
AUTH_APP_URL=https://auth-binzeo.vercel.app
ADMIN_APP_URL=https://admin-binzeo.vercel.app
WEBAUTHN_RP_ID=auth-binzeo.vercel.app
# Generate with: openssl rand -base64 32; keep only in the central API secret environment.
CENTRAL_OAUTH_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Provider integrations; set only in the central server environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://auth-binzeo.vercel.app/api/auth/google/callback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
CRON_SECRET=

# Central Stripe payments (server-only). Configure only after account country/currency review.
# Keep the DB provider/site settings disabled until a tested payment adapter is ready.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVE_CHARGES_ENABLED=false

# JABIYEN brand database (kept separate from Central Auth)
JABIYEN_SUPABASE_URL=https://eiueitoxxqzkolsouuzy.supabase.co
JABIYEN_SUPABASE_ANON_KEY=
JABIYEN_SUPABASE_SERVICE_ROLE_KEY=
